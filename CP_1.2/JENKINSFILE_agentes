pipeline {
    agent none
    
     stages {
        stage('Get Code') {
            agent {label 'windows'}
            steps {
                // Obtener código del repo
                git 'https://github.com/AsuruDev/jenkinshelloworld.git'
                stash name:'code', includes: '**'
            }
        }

    

    stage('Tests')
    {
        parallel {

            stage('Static') {
                agent { label 'linux' }
    
                steps {
                    unstash 'code'

                    sh '''
                        whoami
                        hostname
                        pwd
                    '''
    
                    catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
    
                        sh '''
                            flake8 --exit-zero --format=pylint app>flake8.out
                        '''
    
                        recordIssues(
                            tools: [flake8(name: 'Flake8', pattern: 'flake8.out')],
                            qualityGates: [
                                [threshold: 8, type: 'TOTAL', unstable: true],
                                [threshold: 10, type: 'TOTAL', unstable: false]
                            ]
                        )
                    }
                }
            }
            
            stage('Security'){
                agent { label 'linux' }
                steps {
                    unstash 'code'

                    sh '''
                        whoami
                        hostname
                        pwd
                    '''
                    
                    sh '''
                        bandit --exit-zero -r . -f custom -o bandit.out --msg-template "{abspath}{line}: [{test_id}] {msg}"
                    '''
                    recordIssues(
                            tools: [pyLint(name: 'Bandit', pattern: 'bandit.out')],
                            qualityGates: [
                                [threshold: 2, type: 'TOTAL', unstable: true],
                                [threshold: 4, type: 'TOTAL', unstable: false]
                            ]
                        )
                }
            }    
            
            stage('Unit') {
                agent { label 'linux' }
            
                steps {
                    unstash name: 'code'

                    sh '''
                        whoami
                        hostname
                        pwd
                    '''
            
                    catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                        sh '''
                            export PYTHONPATH=$WORKSPACE
            
                            coverage run --branch --source=app --omit=app/__init__.py,app/api.py -m pytest test/unit
                            coverage xml
                        '''
                    }
            
                    stash name: 'results-unit', includes: 'result-unit.xml, coverage.xml'
                }
            }
            
            stage('Rest') {
                agent {label 'linux'}
                steps {
                    unstash name: 'code'
                    sh '''
                        whoami
                        hostname
                        pwd
                    '''
                    catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                        //falla porque no tengo wiremock funcionando en este agente.
                        sh '''
                            export FLASK_APP=app/api.py
                            export FLASK_ENV=development
                            flask run &
                            export PYTHONPATH=$WORKSPACE
                            sleep 5
                            pytest --junitxml=result-rest.xml test/rest
                        '''
                        }
                        stash name: 'results-rest', includes: 'result-rest.xml'
                    
                    
                }    
            }
            stage ('Coverage'){
                
                agent {label 'linux'}
                
                steps {

                    unstash name: 'code'
                    unstash name: 'results-unit'
                    sh '''
                        whoami
                        hostname
                        pwd
                    '''
            
                    recordCoverage qualityGates: [[criticality: 'NOTE', integerThreshold: 95, metric: 'LINE', threshold: 95.0], [criticality: 'ERROR', integerThreshold: 85, metric: 'LINE', threshold: 85.0], [criticality: 'NOTE', integerThreshold: 90, metric: 'BRANCH', threshold: 90.0], [criticality: 'ERROR', integerThreshold: 80, metric: 'BRANCH', threshold: 80.0]], tools: [[parser: 'COBERTURA', pattern: 'coverage.xml']]
                }
            }
            
            stage ('Performance') {
                
                agent {label 'windows'}
                
                steps {
                    bat '''
                        whoami
                        hostname
                        cd
                    '''
                    bat '''
                        
                        SET FLASK_APP=app/api.py
                        SET FLASK_ENV=development
                        
                        start python -m flask run
                        timeout /t 5
                    
                        
                        C:\\Users\\Jehut\\Downloads\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3\\bin\\jmeter -n -t test\\jmeter\\CP_1.2.jmx -f -l CP_1.2.jtl
                    '''
                    
                    perfReport sourceDataFiles: 'CP_1.2.jtl'
                }
            }
        }
    }
    
    
  }
}
